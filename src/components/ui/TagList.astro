---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="tags" aria-label="Теги">
    {tags.map((tag) => (
      <li class="tags__item">#{tag}</li>
    ))}
  </ul>
)}

<style lang="scss">
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: $color-link;
  }
</style>
