---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FaqList from '@/components/sections/faq/FaqList.astro';
import Button from '@/components/ui/Button.astro';
import PageHero from '@/components/ui/PageHero.astro';
import heroCat from '@/assets/images/faq/hero-cat.png';
import lovebird from '@/assets/images/faq/lovebird.png';
import documentIcon from '@/assets/images/icons/document.png';
import { DIALOG } from '@/config/dialogs';
import { getFaq } from '@/lib/content';

const items = await getFaq();
const lead =
  'Ответы ветеринаров на частые вопросы владельцев. Не нашли свой — задайте его нам, и мы ответим в ближайшее время.';
---

<BaseLayout title="FAQ" description={lead}>
  <PageHero title="FAQ" lead={lead} image={heroCat}>
    <Button variant="secondary" icon={documentIcon} data-dialog-open={DIALOG.askQuestion}>
      Задать вопрос
    </Button>
  </PageHero>

  <section class="container faq-page" aria-label="Вопросы и ответы">
    <FaqList items={items} />
    <Image class="faq-page__decor" src={lovebird} alt="" width={400} />
  </section>
</BaseLayout>

<style lang="scss">
  .faq-page {
    display: grid;
    grid-template-columns: 2fr 1fr;
    align-items: end;
    gap: 40px;

    @include down(lg) {
      grid-template-columns: 1fr;
    }
  }

  .faq-page__decor {
    margin-bottom: -100px;

    @include down(lg) {
      display: none;
    }
  }
</style>
